# AWS Bedrock 자격 증명 (이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# 기준일 고정값 변경 (미설정 시 2026-10-21 사용, 시스템 날짜는 쓰지 않음)
# SAJU_REFERENCE_DATE=2026-10-21

# 답변 모델 교체 (Bedrock 일일 토큰 한도에 걸렸을 때만, 기본 Claude Sonnet 4.5)
# SAJU_LLM_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# 답변 모델이 한도 초과(스로틀링)면 이 순서대로 바꿔 다시 호출 (쉼표 구분, 기본값은 아래와 같음)
# SAJU_LLM_FALLBACKS=global.anthropic.claude-sonnet-4-5-20250929-v1:0,us.anthropic.claude-sonnet-4-6

# 심사·RAGAS 평가 모델 (기본 Claude Sonnet 4.5, SAJU_LLM_MODEL 의 영향을 받지 않음)
# JUDGE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
